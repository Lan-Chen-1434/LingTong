{
 "version": "1.0",
 "name": "窗口系统-弹出提示框",
 "description": "演示「弹出提示框」：弹出确认框等待人工点击，结果（True/False）存入变量。运行后请在弹窗里点击「确定」。",
 "hotkey_run": "f9",
 "hotkey_stop": "f12",
 "start_delay": 2.0,
 "nodes": [
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "本示例演示「弹出提示框」：第 2 步弹出确认框，点「确定」结果为 True、点「取消」为 False。运行后请在弹窗里点击按钮。"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "sys.message",
   "params": {
    "mode": "确认框(等待点击)",
    "message": "演示：点「确定」继续，点「取消」结果为 False",
    "save_var": "user_confirm"
   },
   "enabled": true,
   "note": "类型改「提示(自动继续)」则不等人工点击；提示内容支持 {{变量}}。",
   "children": []
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "用户点击结果：{{user_confirm}}（True=确定，False=取消/关闭）"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "成功",
    "message": "完成：确认结果已存入变量。改成自己的场景：用「条件判断」按 {{user_confirm}} == True 走不同分支。"
   },
   "enabled": true,
   "note": "",
   "children": []
  }
 ]
}