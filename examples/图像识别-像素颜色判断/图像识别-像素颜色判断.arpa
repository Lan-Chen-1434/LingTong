{
  "version": "1.0",
  "name": "图像识别-像素颜色判断",
  "description": "演示像素颜色判断（判断按钮是否高亮/状态灯颜色），坐标需按你的屏幕用取色器拾取修改。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "本示例演示：读取指定坐标的颜色并与目标色比较，结果写入变量 color_ok，实际颜色在 {{color_ok.rgb}}。坐标要改成你屏幕上的取样点。"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "image.pixel",
      "params": {
        "x": 100,
        "y": 100,
        "color": "#00A2FF",
        "tolerance": 20,
        "save_var": "color_ok"
      },
      "enabled": true,
      "note": "点右侧取色器从屏幕拾取取样点坐标（X/Y），目标颜色改成你要判断的颜色",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "判断结果 {{color_ok}}，取样点实际颜色 RGB = {{color_ok.rgb}}"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "像素判断演示结束。改成自己的场景：配合上一步「图像点击」保存的 last_point，开启「坐标来自变量」即可对点击位置验色。"
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}