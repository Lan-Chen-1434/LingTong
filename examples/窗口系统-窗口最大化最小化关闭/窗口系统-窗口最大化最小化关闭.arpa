{
 "version": "1.0",
 "name": "窗口系统-窗口最大化最小化关闭",
 "description": "演示「窗口最大化/最小化/关闭」：先把记事本激活，再最大化。运行前先打开记事本（macOS 打开 TextEdit）。",
 "hotkey_run": "f9",
 "hotkey_stop": "f12",
 "start_delay": 2.0,
 "nodes": [
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "本示例演示「窗口最大化/最小化/关闭」：先激活记事本，再把它最大化。运行前请先打开记事本（macOS 打开 TextEdit）。"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "win.activate",
   "params": {
    "title": "记事本"
   },
   "enabled": true,
   "note": "先激活目标窗口；标题关键字按你的窗口改（macOS 填 文本编辑）。",
   "children": []
  },
  {
   "type_id": "win.state",
   "params": {
    "title": "记事本",
    "action": "最大化",
    "wait": 0.5
   },
   "enabled": true,
   "note": "操作可改 最小化 / 关闭（关闭会直接关掉窗口）；截图取图前建议先最大化。",
   "children": []
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "成功",
    "message": "完成：窗口已最大化。改成自己的场景：取图前最大化、处理完最小化、收尾时关掉弹窗等。"
   },
   "enabled": true,
   "note": "",
   "children": []
  }
 ]
}