{
  "version": "1.0",
  "name": "键盘操作-热键触发输入",
  "description": "演示「热键触发输入」：流程执行到这里会等待，人工在任意窗口按下 ctrl+alt+q 后，自动把内容输入到当前焦点处。运行前先打开记事本（macOS 用 TextEdit）并把光标停在编辑区；macOS 上 ctrl 即 ⌘ Command。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "本示例演示热键触发输入：流程会停在下一步等待，人工按下 ctrl+alt+q 后自动键入回复语。运行前先打开记事本（macOS 用 TextEdit）并把光标停在编辑区；触发前随时可以按 F12 停止。"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "key.hotkey_type",
      "params": {
        "hotkey": "ctrl+alt+q",
        "text": "您好，已收到您的问题，正在为您处理，请稍候。",
        "press_enter": true
      },
      "enabled": true,
      "note": "「触发快捷键」点输入框后直接按组合键录入；「输入内容」支持 {{变量}}。适合客服快捷回复：运行后到处可用，按热键即在光标处输出。",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "完成：学会热键触发输入。改成自己的场景：把「触发快捷键」「输入内容」换成自己的快捷回复组合即可，可配合「运行控制」里的超时设置。"
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}