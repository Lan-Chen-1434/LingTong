{
  "version": "1.0",
  "name": "图像识别-判断图像是否存在",
  "description": "演示判断图像是否存在（结果写入变量供条件判断用）。运行前先给「判断图像是否存在」步骤抓图。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "本示例演示：检测界面上有没有某个元素，结果 True/False 写入变量 image_found，可接「条件判断」模块走分支。运行前先给该步骤抓图。"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "image.exists",
      "params": {
        "wait": 3.0,
        "save_var": "image_found",
        "on_error": "跳过此步"
      },
      "enabled": true,
      "note": "运行前：选中此步骤，点右侧【抓图取图】截一张目标图；已设失败策略=跳过此步，未抓图也能跑通流程",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "判断结果：{{image_found}}（True=存在；存在时还可读 {{image_found.x}}, {{image_found.y}}）"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "存在性判断演示结束。改成自己的场景：换模板图后在后面加「条件判断」节点，条件写 {{image_found}} == True。"
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}