{
 "version": "1.0",
 "name": "窗口系统-等待延时",
 "description": "演示「等待延时」：固定等待 2 秒，再附加 0~1 秒随机抖动模拟真人节奏。运行无需准备。",
 "hotkey_run": "f9",
 "hotkey_stop": "f12",
 "start_delay": 2.0,
 "nodes": [
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "本示例演示「等待延时」：第 2 步固定等 2 秒，并附加 0~1 秒随机抖动，实际等待 2~3 秒。运行无需准备。"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "sys.wait",
   "params": {
    "seconds": 2.0,
    "random_extra": 1.0
   },
   "enabled": true,
   "note": "等待时长与抖动按场景调整；页面加载慢就加大等待。",
   "children": []
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "成功",
    "message": "完成：等待结束。改成自己的场景：在等界面加载、动画播完的步骤之间放本节点，固定等待用它，随机节奏用「随机延时」模块。"
   },
   "enabled": true,
   "note": "",
   "children": []
  }
 ]
}