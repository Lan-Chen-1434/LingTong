{
  "version": "1.0",
  "name": "01-新手示例-打开记事本并输入文字",
  "description": "演示最基础的三个能力：启动程序、激活窗口、键盘输入。运行前请先保存好手头工作。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "准备启动记事本，2 秒后开始…",
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "sys.run",
      "params": {
        "path": "notepad.exe",
        "args": "",
        "wait": 1.5,
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "win.activate",
      "params": {
        "title": "记事本",
        "exact": false,
        "wait": 0.6,
        "on_error": "跳过此步",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "sys.wait",
      "params": {
        "seconds": 0.6,
        "random_extra": 0.0,
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "key.paste_text",
      "params": {
        "text": "你好！这一行是灵瞳自动输入的。\n运行时间：{{datetime}}\n屏幕分辨率：{{sys_info.screen_width}} × {{sys_info.screen_height}}\n下面会自动按 3 次回车。",
        "clear_first": true,
        "restore_clipboard": true,
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "flow.loop",
      "params": {
        "mode": "固定次数",
        "times": 3,
        "loop_index_name": "loop_index",
        "dataset": "{{rows}}",
        "src_type": "自动",
        "item_var": "item",
        "condition": "{{count}} < 10",
        "max_times": 200,
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": [
        {
          "type_id": "key.press",
          "params": {
            "key": "enter",
            "times": 1,
            "interval": 0.1,
            "wait_after": 0.25,
            "on_error": "停止流程",
            "retry": 3,
            "retry_interval": 1.0,
            "timeout": 0.0
          },
          "enabled": true,
          "note": "",
          "children": []
        }
      ]
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "演示完成 ✔ 你可以把「键盘输入文本」改成你自己的内容",
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}