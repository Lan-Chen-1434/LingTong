{
 "version": "1.0",
 "name": "窗口系统-窗口内运行",
 "description": "演示「窗口内运行」：容器内步骤始终针对目标窗口执行，窗口被抢占会自动抢回前台。运行前先打开记事本（macOS 打开 TextEdit）。",
 "hotkey_run": "f9",
 "hotkey_stop": "f12",
 "start_delay": 2.0,
 "nodes": [
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "本示例演示「窗口内运行」：第 2 步是容器，里面的步骤始终针对记事本执行，运行期间窗口掉出前台会自动抢回。运行前请先打开记事本（macOS 打开 TextEdit）。"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "win.scope",
   "params": {
    "title": "记事本"
   },
   "enabled": true,
   "note": "标题关键字改成目标窗口；把要针对该窗口的全部步骤拖进容器里。",
   "children": [
    {
     "type_id": "util.log",
     "params": {
      "level": "信息",
      "message": "此步骤在容器内执行——运行期间目标窗口被抢占会自动抢回前台"
     },
     "enabled": true,
     "note": "",
     "children": []
    },
    {
     "type_id": "key.type",
     "params": {
      "text": "这行字由容器内的「键盘输入文本」写入记事本。"
     },
     "enabled": true,
     "note": "容器内步骤面向目标窗口，可换成你的点击 / 输入等操作。",
     "children": []
    }
   ]
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "成功",
    "message": "完成：容器内步骤执行完毕。改成自己的场景：把针对同一窗口的步骤都收进容器，窗口响应慢时调大「切换后等待 / 尝试间隔」。"
   },
   "enabled": true,
   "note": "",
   "children": []
  }
 ]
}