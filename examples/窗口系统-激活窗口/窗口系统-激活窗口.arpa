{
 "version": "1.0",
 "name": "窗口系统-激活窗口",
 "description": "演示「激活窗口」：按标题关键字把记事本切到前台。运行前先打开记事本（macOS 打开 TextEdit），并把标题关键字改成你的窗口。",
 "hotkey_run": "f9",
 "hotkey_stop": "f12",
 "start_delay": 2.0,
 "nodes": [
  {
   "type_id": "util.log",
   "params": {
    "level": "信息",
    "message": "本示例演示「激活窗口」：第 2 步按标题关键字「记事本」把窗口切到前台。运行前请先打开记事本（macOS 打开 TextEdit），否则会报错并列出当前窗口标题。"
   },
   "enabled": true,
   "note": "",
   "children": []
  },
  {
   "type_id": "win.activate",
   "params": {
    "title": "记事本",
    "wait": 1.0
   },
   "enabled": true,
   "note": "标题关键字改成目标窗口，如 Chrome / Excel（macOS 填 文本编辑 / Safari）；窗口较多时开「标题完全匹配」精确定位。",
   "children": []
  },
  {
   "type_id": "util.log",
   "params": {
    "level": "成功",
    "message": "完成：窗口已切到前台。改成自己的场景：换标题关键字即可，它是几乎所有自动化流程的第一步。"
   },
   "enabled": true,
   "note": "",
   "children": []
  }
 ]
}