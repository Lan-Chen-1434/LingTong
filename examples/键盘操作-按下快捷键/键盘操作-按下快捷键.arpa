{
  "version": "1.0",
  "name": "键盘操作-按下快捷键",
  "description": "演示「按下快捷键」：发送 ctrl+c / ctrl+v 等组合键。运行前先在记事本里选中一段文字；macOS 上 ctrl 即 ⌘ Command。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "level": "信息",
        "message": "本示例演示按下快捷键：先 Ctrl+C 复制选中的文字，再 Ctrl+V 连粘 3 次。运行前请在记事本（macOS 用 TextEdit）里选中一段文字。"
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "key.hotkey",
      "params": {
        "keys": "ctrl+c",
        "wait_after": 0.5
      },
      "enabled": true,
      "note": "「快捷键」点输入框后直接按组合键录入；macOS 上 ctrl 指 ⌘ Command。",
      "children": []
    },
    {
      "type_id": "key.hotkey",
      "params": {
        "keys": "ctrl+v",
        "times": 3,
        "interval": 0.2,
        "wait_after": 0.5
      },
      "enabled": true,
      "note": "「执行次数」3 = 连按 3 次；「间隔」控制相邻两次之间的等待。",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "完成：学会发送组合键与连按。改成自己的场景：把「快捷键」换成自己的组合键，如保存 ctrl+s、关闭窗口 alt+f4（macOS 填 command+q）。"
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}