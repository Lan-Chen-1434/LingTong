{
  "version": "1.0",
  "name": "文件操作-打开文件夹",
  "description": "演示打开文件夹：在系统文件管理器中展示目录，常用于流程结束后打开输出目录。运行前无需准备；默认打开本流程的 output 目录。Windows 绝对路径如 C:/报告，macOS 如 /Users/你/Documents。",
  "hotkey_run": "f9",
  "hotkey_stop": "f12",
  "start_delay": 2.0,
  "nodes": [
    {
      "type_id": "util.log",
      "params": {
        "message": "本示例演示「打开文件夹」：2 秒后会在文件管理器中打开 output 目录。",
        "level": "信息",
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    },
    {
      "type_id": "util.open_folder",
      "params": {
        "path": "output",
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "目录改成你想打开的文件夹；相对路径基于本流程文件夹，不存在会自动创建",
      "children": []
    },
    {
      "type_id": "util.log",
      "params": {
        "level": "成功",
        "message": "完成。把目录改为你流程的输出目录（如 output/excel），即可在运行结束后自动展示结果。",
        "on_error": "停止流程",
        "retry": 3,
        "retry_interval": 1.0,
        "timeout": 0.0
      },
      "enabled": true,
      "note": "",
      "children": []
    }
  ]
}